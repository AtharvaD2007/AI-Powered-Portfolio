# ==========================================
# AI-Powered Portfolio & Resume Generator
# Backend Environment Configuration
# ==========================================

# Flask Security
SECRET_KEY=change-this-to-a-secure-random-secret

# Google Gemini API
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Google Sheets Integration
# Option A: Path to Google Service Account JSON file
GOOGLE_SHEETS_CREDENTIALS_JSON=backend/service_account.json

# Option B: Alternatively set standard Google Cloud application credentials path
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# Target Google Sheet ID (extracted from sheet URL: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit)
# Make sure to share your Google Sheet with your service account email with "Editor" access.
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Database Configuration (Defaults to backend/data/portfolio.db)
# DATABASE_PATH=backend/data/portfolio.db

# Flask Server Port
PORT=5001
